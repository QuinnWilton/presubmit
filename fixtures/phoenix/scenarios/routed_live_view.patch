From 86454d45ff1cc8f36627d8740a4d2d863ee9fda0 Mon Sep 17 00:00:00 2001
From: Fixture <fixture@example.com>
Date: Thu, 1 Jan 2026 01:00:00 +0000
Subject: Add posts live view

---
 lib/demo_web/live/post_live.ex | 6 ++++++
 lib/demo_web/router.ex         | 1 +
 2 files changed, 7 insertions(+)
 create mode 100644 lib/demo_web/live/post_live.ex

diff --git a/lib/demo_web/live/post_live.ex b/lib/demo_web/live/post_live.ex
new file mode 100644
index 0000000..da4efc3
--- /dev/null
+++ b/lib/demo_web/live/post_live.ex
@@ -0,0 +1,6 @@
+defmodule DemoWeb.PostLive do
+  use DemoWeb, :live_view
+
+  @impl true
+  def mount(_params, _session, socket), do: {:ok, assign(socket, posts: Demo.Blog.list_posts())}
+end
diff --git a/lib/demo_web/router.ex b/lib/demo_web/router.ex
index 3fc895c..1e5f164 100644
--- a/lib/demo_web/router.ex
+++ b/lib/demo_web/router.ex
@@ -9,5 +9,6 @@ defmodule DemoWeb.Router do
     pipe_through :browser
 
     get "/users", UserController, :index
+    live "/posts", PostLive
   end
 end
