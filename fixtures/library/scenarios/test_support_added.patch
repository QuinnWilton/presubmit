From 75d4b549dc260ad704d940e8f361a8973d58f9b1 Mon Sep 17 00:00:00 2001
From: Fixture <fixture@example.com>
Date: Thu, 1 Jan 2026 01:00:00 +0000
Subject: Add test names compiled from test/support

---
 mix.exs                       | 11 ++++++++++-
 test/support/toolkit/names.ex |  3 +++
 test/toolkit_test.exs         |  4 ++++
 3 files changed, 17 insertions(+), 1 deletion(-)
 create mode 100644 test/support/toolkit/names.ex

diff --git a/mix.exs b/mix.exs
index 572a311..fd896e5 100644
--- a/mix.exs
+++ b/mix.exs
@@ -4,9 +4,18 @@ defmodule Toolkit.MixProject do
   @version "0.1.0"
 
   def project do
-    [app: :toolkit, version: @version, elixir: "~> 1.19", deps: deps()]
+    [
+      app: :toolkit,
+      version: @version,
+      elixir: "~> 1.19",
+      elixirc_paths: elixirc_paths(Mix.env()),
+      deps: deps()
+    ]
   end
 
+  defp elixirc_paths(:test), do: ["lib", "test/support"]
+  defp elixirc_paths(_), do: ["lib"]
+
   defp deps do
     [
       {:jason, "~> 1.4"}
diff --git a/test/support/toolkit/names.ex b/test/support/toolkit/names.ex
new file mode 100644
index 0000000..ced279f
--- /dev/null
+++ b/test/support/toolkit/names.ex
@@ -0,0 +1,3 @@
+defmodule Toolkit.Names do
+  def names, do: ["Ada", "Grace"]
+end
diff --git a/test/toolkit_test.exs b/test/toolkit_test.exs
index c0cfb5b..e578019 100644
--- a/test/toolkit_test.exs
+++ b/test/toolkit_test.exs
@@ -4,4 +4,8 @@ defmodule ToolkitTest do
   test "greet/1" do
     assert Toolkit.greet("Ada") == "Hello, Ada!"
   end
+
+  test "greet/1 greets every name" do
+    for name <- Toolkit.Names.names(), do: assert(Toolkit.greet(name) =~ name)
+  end
 end
