+- Added `Toolkit.Case`.
+
 ## 0.1.0
 
 - Initial release.
diff --git a/lib/toolkit/case.ex b/lib/toolkit/case.ex
new file mode 100644
index 0000000..654d004
--- /dev/null
+++ b/lib/toolkit/case.ex
@@ -0,0 +1,6 @@
+defmodule Toolkit.Case do
+  @moduledoc "Case conversion."
+
+  @spec snake(String.t()) :: String.t()
+  def snake(text), do: text |> String.downcase() |> String.replace(" ", "_")
+end
diff --git a/test/toolkit/case_test.exs b/test/toolkit/case_test.exs
new file mode 100644
index 0000000..e4a2316
--- /dev/null
+++ b/test/toolkit/case_test.exs
@@ -0,0 +1,3 @@
+defmodule Toolkit.CaseTest do
+  use ExUnit.Case, async: true
+end
