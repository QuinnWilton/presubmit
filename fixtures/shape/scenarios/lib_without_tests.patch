From: Fixture <fixture@example.com>
Date: Thu, 1 Jan 2026 01:00:00 +0000
Subject: Round totals up

---
 lib/shop/cart.ex | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/lib/shop/cart.ex b/lib/shop/cart.ex
index 24d53f1..0cb3ef9 100644
--- a/lib/shop/cart.ex
+++ b/lib/shop/cart.ex
@@ -5,7 +5,7 @@ defmodule Shop.Cart do
 
   @spec total(t()) :: non_neg_integer()
   def total(%__MODULE__{items: items}) do
-    Enum.reduce(items, 0, fn item, acc -> acc + item.price * item.quantity end)
+    Enum.reduce(items, 0, fn item, acc -> acc + ceil(item.price * item.quantity) end)
   end
 
   @type t :: %__MODULE__{items: [Shop.Cart.Item.t()]}
