Subject: Format cart.ex

---
 lib/shop/cart.ex | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/lib/shop/cart.ex b/lib/shop/cart.ex
index 24d53f1..d71a848 100644
--- a/lib/shop/cart.ex
+++ b/lib/shop/cart.ex
@@ -5,7 +5,9 @@ defmodule Shop.Cart do
 
   @spec total(t()) :: non_neg_integer()
   def total(%__MODULE__{items: items}) do
-    Enum.reduce(items, 0, fn item, acc -> acc + item.price * item.quantity end)
+    Enum.reduce(items, 0, fn item, acc ->
+      acc + item.price * max(item.quantity, 1)
+    end)
   end
 
   @type t :: %__MODULE__{items: [Shop.Cart.Item.t()]}
